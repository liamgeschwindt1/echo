{
  "name": "echo-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/service.mjs build",
    "start": "node scripts/service.mjs start",
    "dev": "node scripts/dev.mjs",
    "test": "npm test --workspaces --if-present",
    "build:backend": "echo 'backend has no build step'",
    "build:echo": "npm run fetch-models -w @echo/assets && npm run build -w @echo/echo",
    "build:sim": "npm run fetch-models -w @echo/assets && npm run fetch-test-audio -w @echo/assets && npm run build -w @echo/sim",
    "start:backend": "npm start -w @echo/backend",
    "start:echo": "npm start -w @echo/echo",
    "start:sim": "npm start -w @echo/sim"
  },
  "engines": {
    "node": ">=20"
  }
}
